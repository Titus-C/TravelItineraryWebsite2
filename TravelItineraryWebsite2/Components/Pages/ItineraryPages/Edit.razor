@page "/itineraries/edit"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using TravelItineraryWebsite2.Data
@using TravelItineraryWebsite2.Domain
@inject IDbContextFactory<TravelItineraryWebsite2.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@rendermode InteractiveServer

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Itinerary</h2>
<hr />
@if (Itinerary is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Itinerary" OnValidSubmit="UpdateItinerary" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Itinerary.Id" value="@Itinerary.Id" />
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Itinerary.Name" class="form-control" />
                    <ValidationMessage For="() => Itinerary.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label>
                    <InputText id="description" @bind-Value="Itinerary.Description" class="form-control" />
                    <ValidationMessage For="() => Itinerary.Description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="startdate" class="form-label">StartDate:</label>
                    <InputDate id="startdate" @bind-Value="Itinerary.StartDate" class="form-control" />
                    <ValidationMessage For="() => Itinerary.StartDate" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="enddate" class="form-label">EndDate:</label>
                    <InputDate id="enddate" @bind-Value="Itinerary.EndDate" class="form-control" />
                    <ValidationMessage For="() => Itinerary.EndDate" class="text-danger" />
                </div>

                @* <div class="mb-3">
                    <label>Add User?</label>
                    <input type="checkbox" checked="@addUser" @onchange="@(e => StateHasChanged())">
                </div> *@

                <div class="mb-3">
                    <label>Add User?</label>
                    <InputCheckbox @bind-Value="addUser" />
                </div>

                <p>@addUser</p>

                @if (addUser)
                {
                    <div class="mb-3">
                        <label for="users" class="form-label">Add User</label>
                        <InputSelect id="users" @bind-Value="selectedUserId" class="form-control">
                            @foreach (var user in allUsers)
                            {
                                <option value="@user.Id">@user.UserName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => selectedUserId" class="text-danger" />
                    </div>
                }

                <div class="mb-3">
                    <label>Remove User?</label>
                    <InputCheckbox @bind-Value="removeUser" />
                </div>

                @if (removeUser)
                {
                    <div class="mb-3">
                        <label for="removeUsers" class="form-label">Remove User</label>
                        <InputSelect id="removeUsers" @bind-Value="selectedRemoveUserId" class="form-control">
                            @foreach (var user in Itinerary.Users)
                            {
                                <option value="@user.Id">@user.UserName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => selectedRemoveUserId" class="text-danger" />
                    </div>
                }

                @*
                <div class="mb-3">
                    <label for="datecreated" class="form-label">DateCreated:</label>
                    <InputDate id="datecreated" @bind-Value="Itinerary.DateCreated" class="form-control" />
                    <ValidationMessage For="() => Itinerary.DateCreated" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="dateupdated" class="form-label">DateUpdated:</label>
                    <InputDate id="dateupdated" @bind-Value="Itinerary.DateUpdated" class="form-control" />
                    <ValidationMessage For="() => Itinerary.DateUpdated" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="createdby" class="form-label">CreatedBy:</label>
                    <InputText id="createdby" @bind-Value="Itinerary.CreatedBy" class="form-control" />
                    <ValidationMessage For="() => Itinerary.CreatedBy" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="updatedby" class="form-label">UpdatedBy:</label>
                    <InputText id="updatedby" @bind-Value="Itinerary.UpdatedBy" class="form-control" />
                    <ValidationMessage For="() => Itinerary.UpdatedBy" class="text-danger" />
                </div>
                *@
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/itineraries">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Itinerary? Itinerary { get; set; }

    bool addUser = false;
    bool removeUser = false;

    //Create userId string to store the user id, default value is "System".
    private string userId = "SystemId";
    private string userName = "System";
    //Inject the AuthenticationStateProvider to get the user id.
    @inject AuthenticationStateProvider authenticationStateProvider

    private ICollection<ApplicationUser> allUsers = new List<ApplicationUser>();
    private string? selectedUserId;
    private string? selectedRemoveUserId;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Itinerary = await context.Itinerary.Include(i => i.Users).FirstOrDefaultAsync(m => m.Id == Id);

        allUsers = await UserManager.Users.ToListAsync();

        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userId = UserManager.GetUserId(user);

            var appUser = await UserManager.GetUserAsync(user);
            if (appUser != null)
            {
                userName = appUser.FirstName;
            }
        }

        if (Itinerary is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // private void CheckboxChanged()
    // {
    //     addUser = this.addUser
    // }


    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateItinerary()
    {
        using var context = DbFactory.CreateDbContext();

        Itinerary.UpdatedBy = userId;
        Itinerary.UpdatedByName = userName;

        Itinerary.DateUpdated = DateTime.Now;

        // Handle adding selected user
        if (addUser && !string.IsNullOrEmpty(selectedUserId))
        {
            var user = await UserManager.FindByIdAsync(selectedUserId);
            if (user != null && !Itinerary.Users.Contains(user))
            {
                context.Attach(user);
                Itinerary.Users.Add(user);
            }
        }

        // Handle removing selected user
        if (removeUser && !string.IsNullOrEmpty(selectedRemoveUserId))
        {
            var userToRemove = await UserManager.FindByIdAsync(selectedRemoveUserId);
            if (userToRemove != null && Itinerary.Users.Contains(userToRemove))
            {
                Itinerary.Users.Remove(userToRemove);
            }
        }

        context.Attach(Itinerary!).State = EntityState.Modified;

        // Exclude the DateCreated and CreatedByName from being updated
        context.Entry(Itinerary).Property(e => e.DateCreated).IsModified = false;
        context.Entry(Itinerary).Property(e => e.CreatedByName).IsModified = false;
        context.Entry(Itinerary).Property(e => e.CreatedBy).IsModified = false;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ItineraryExists(Itinerary!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/itineraries");
    }

    private bool ItineraryExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Itinerary.Any(e => e.Id == id);
    }
}
