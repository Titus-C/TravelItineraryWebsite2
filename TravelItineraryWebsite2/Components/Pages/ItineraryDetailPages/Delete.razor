@page "/itinerarydetails/delete"
@using Microsoft.EntityFrameworkCore
@using TravelItineraryWebsite2.Domain
@inject IDbContextFactory<TravelItineraryWebsite2.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>ItineraryDetail</h2>
    <hr />
    @if (itinerarydetail is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@itinerarydetail.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ItineraryId</dt>
            <dd class="col-sm-10">@itinerarydetail.ItineraryId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Date</dt>
            <dd class="col-sm-10">@itinerarydetail.Date</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Duration</dt>
            <dd class="col-sm-10">@itinerarydetail.Duration</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ArrivalTime</dt>
            <dd class="col-sm-10">@itinerarydetail.ArrivalTime</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Category</dt>
            <dd class="col-sm-10">@itinerarydetail.Category</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@itinerarydetail.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Activity</dt>
            <dd class="col-sm-10">@itinerarydetail.Activity</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">LocationId</dt>
            <dd class="col-sm-10">@itinerarydetail.LocationId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DateCreated</dt>
            <dd class="col-sm-10">@itinerarydetail.DateCreated</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DateUpdated</dt>
            <dd class="col-sm-10">@itinerarydetail.DateUpdated</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CreatedBy</dt>
            <dd class="col-sm-10">@itinerarydetail.CreatedBy</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UpdatedBy</dt>
            <dd class="col-sm-10">@itinerarydetail.UpdatedBy</dd>
        </dl>
        <EditForm method="post" Model="itinerarydetail" OnValidSubmit="DeleteItineraryDetail" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(itinerarydetail is null)">Delete</button> |
            <a href="/itinerarydetails">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private ItineraryDetail? itinerarydetail;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        itinerarydetail = await context.ItineraryDetail.FirstOrDefaultAsync(m => m.Id == Id);

        if (itinerarydetail is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteItineraryDetail()
    {
        using var context = DbFactory.CreateDbContext();
        context.ItineraryDetail.Remove(itinerarydetail!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/itinerarydetails");
    }
}
